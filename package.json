{
  "name": "tawil-media",
  "version": "1.0.0",
  "description": "Professional Media and Advertisement Platform",
  "scripts": {
    "build": "node scripts/build/build.js",
    "build:css": "node scripts/build/css.js",
    "build:js": "node scripts/build/js.js",
    "build:scss": "node scripts/build/compile-scss.js",
    "build:scss:prod": "node scripts/build/compile-scss.js --production",
    "build:tailwind": "npx tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.css",
    "build:tailwind:prod": "npx tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.css --minify",
    "build:design-system": "node scripts/build/design-system.js",
    "build:design-system:prod": "node scripts/build/design-system.js --production",
    "watch": "node scripts/build/build.js --watch",
    "watch:scss": "node scripts/build/compile-scss.js --watch",
    "watch:tailwind": "npx tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.css --watch",
    "watch:design-system": "node scripts/build/design-system.js --watch",
    "optimize": "node scripts/optimize/assets.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.13",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "alpinejs": "^3.13.3",
    "chart.js": "^4.4.8",
    "framer-motion": "^12.5.0",
    "gsap": "^3.12.7",
    "htmx.org": "^1.9.6",
    "motion": "^12.5.0"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.16",
    "chokidar": "^3.5.3",
    "cssnano": "^6.0.2",
    "esbuild": "^0.25.0",
    "glob": "^10.3.10",
    "postcss": "^8.4.32",
    "postcss-import": "^15.1.0",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^10.1.5",
    "postcss-scss": "^4.0.9",
    "sass": "^1.86.0",
    "tailwindcss": "^3.4.0"
  }
}
