# Copy to .env and export before running (e.g. `set -a; source .env; set +a`).
DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://example.com

# Leave unset to use SQLite (db.sqlite3). Set POSTGRES_DB to switch to PostgreSQL.
# POSTGRES_DB=tawil
# POSTGRES_USER=tawil
# POSTGRES_PASSWORD=secret
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email (console backend is used automatically when DEBUG=1)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Tawil Media <noreply@example.com>
